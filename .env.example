# Sangyan AI Investor Shield - Environment Configuration Example
# Copy this file to .env and configure for your local/deployment environment.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (SQLite default for zero-friction local run; PostgreSQL for production)
DATABASE_URL=sqlite:///./sangyan_shield.db

# Vector Store Configuration
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/processed/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM / Reasoning Provider (offline_rule_fallback for offline demo/IIT hackathon, or api)
LLM_PROVIDER=offline_rule_fallback
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# OCR Settings
OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=60.0

# Deployment & Public URLs
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
APP_URL=http://localhost:5173

# ============================================================================
# PRODUCTION AUTHENTICATION & OWNER VERIFICATION
# ============================================================================

# JWT & Session Security (Generate a 64+ char random string in production)
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-59281
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Email OTP Delivery Provider (Select: 'smtp' or 'resend')
# If not configured, verification will honestly return: "Email verification service is not configured."
EMAIL_PROVIDER=
EMAIL_FROM=security@sangyan.gov.in

# Option A: Standard SMTP Credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Option B: Resend Transactional Provider API Key
RESEND_API_KEY=

# Face & Liveness Verification Provider (Enterprise endpoint)
# If not configured, verification will honestly return: "Identity verification provider is not configured."
LIVENESS_PROVIDER_URL=
LIVENESS_API_KEY=

# WebAuthn / Passkey Platform Authenticator Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sangyan AI Investor Shield

# Valid Owner Activation Codes (Comma-separated)
VALID_ACTIVATION_CODES=SANGYAN-2026,INVESTOR-SHIELD-2026,SANGYAN-ALPHA,SEBI-PROTECT-2026
